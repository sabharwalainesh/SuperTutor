# Copy to .env at the repository root. Do not commit .env.
# No Claude or other model API key is needed. Go performs the tutoring.
API_PORT=8787
MCP_PORT=8788
API_BASE_URL=http://127.0.0.1:8787
TUTOR_STATE_FILE=.data/tutor-state.json
# Required only for the MCP bridge. Generate locally; never commit or share it.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MCP_BEARER_TOKEN=
