# Copy to .env at the repository root. Do not commit .env.
# No model API key is needed. Superhuman Go performs all tutoring and practice review.

# One server hosts the workspace, the /api routes, and the authenticated /mcp endpoint.
PORT=8787
# Bind to 0.0.0.0 only when something in front of it terminates TLS.
HOST=127.0.0.1
TUTOR_STATE_FILE=.data/tutor-state.json

# Production: set NODE_ENV=production, serve over HTTPS, and keep the session cookie Secure.
# NODE_ENV=production
# Force Secure cookies when TLS is terminated by a proxy or tunnel ahead of this server.
# SECURE_COOKIES=true
# Required behind a proxy so client IPs (used for sign-in rate limiting) are read correctly.
# TRUST_PROXY=true

# Vercel: connect a PostgreSQL integration (for example Neon). The API and MCP function
# store state transactionally there; .data/ and /tmp are never used for cloud persistence.
# DATABASE_URL=postgresql://...
# POSTGRES_URL is also accepted for integrations that provide that name instead.
# The stable production origin advertised to Go (never a protected preview URL).
# SUPERTUTOR_PUBLIC_ORIGIN=https://super-tutor-mauve.vercel.app

# There is no shared MCP token any more. Each student generates their own connector token
# in the workspace under "Connect your tutor"; only its hash is stored.

# Publish the connector pack ONCE as the maintainer, then put its store listing URL here.
# Students then install it instead of pasting pack source. Leave unset and the setup screen
# shows the publishing step instead of an install link.
# CONNECTOR_LISTING_URL=https://superhuman.com/store/connectors/your-supertutor-listing
# Where students search for the published tutor agents.
# AGENT_DIRECTORY_URL=https://go.superhuman.com/agent-directory

# Canvas needs no server configuration: each student connects with their own Canvas access
# token, which is stored per account and deleted when they disconnect.

# Optional Canvas OAuth sign-in. Each school must approve its own Canvas developer key.
# This is a Canvas app registration, not a model API key. Students authorize on Canvas.
# Provide a JSON array so the sign-in screen can offer multiple schools.
# Register the exact redirectUri on each school's developer key.
# CANVAS_OAUTH_INSTITUTIONS=[{"id":"berkeley","name":"UC Berkeley / bCourses","baseUrl":"https://bcourses.berkeley.edu","clientId":"YOUR_CLIENT_ID","clientSecret":"YOUR_CLIENT_SECRET","redirectUri":"http://localhost:5173/api/auth/canvas/callback"},{"id":"your-school","name":"Your University","baseUrl":"https://canvas.yourschool.edu","clientId":"YOUR_OTHER_CLIENT_ID","clientSecret":"YOUR_OTHER_CLIENT_SECRET","redirectUri":"http://localhost:5173/api/auth/canvas/callback"}]
