{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:web",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/handler.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/handler?__supertutor_route=/api/:path*" },
    { "source": "/mcp", "destination": "/api/handler?__supertutor_route=/mcp" },
    { "source": "/healthz", "destination": "/api/handler?__supertutor_route=/healthz" }
  ]
}
