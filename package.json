{
  "name": "supertutor",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:mcp": "tsx watch scripts/mcp-server.ts",
    "dev:connected": "concurrently -k -n api,web,mcp -c cyan,magenta,green \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:mcp\"",
    "dev:desktop": "wait-on tcp:5173 && npm run build:desktop && electron apps/desktop/dist/main.js",
    "build": "npm run build:web && npm run build:desktop",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:desktop": "tsc -p apps/desktop/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test apps/api/test/*.test.ts scripts/test/*.test.ts",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "engines": {
    "node": ">=22"
  }
}
