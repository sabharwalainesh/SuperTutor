{
  "name": "supertutor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web,app -c cyan,magenta,yellow \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:desktop\"",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:desktop": "wait-on tcp:5173 && npm run build:desktop && electron apps/desktop/dist/main.js",
    "dev:mock": "tsx scripts/mock-server.ts",
    "build": "npm run build:web && npm run build:desktop",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:desktop": "tsc -p apps/desktop/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  }
}
