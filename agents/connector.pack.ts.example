// Paste into Superhuman Pack Studio. Replace BOTH example hostnames.
// Account prerequisites and installation: docs/GO_SETUP.md.
import * as sdk from '@codahq/packs-sdk';
export const pack = sdk.newPack();
pack.addMCPServer({ name: 'SuperTutor', endpointUrl: 'https://YOUR-TUNNEL.example/mcp' });
pack.setUserAuthentication({
  type: sdk.AuthenticationType.HeaderBearerToken,
  instructionsUrl: 'https://github.com/sabharwalainesh/SuperTutor/blob/main/docs/GO_SETUP.md',
});
pack.addNetworkDomain('YOUR-TUNNEL.example');
